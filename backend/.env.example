# Local: ruta al archivo JSON de credenciales
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# Render: pega aquí el JSON completo de la cuenta de servicio (una línea)
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# URL de Realtime Database (ej: https://tu-proyecto-default-rtdb.firebaseio.com)
FIREBASE_DATABASE_URL=https://tu-proyecto-default-rtdb.firebaseio.com

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:4200
